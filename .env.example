# ==============================================================================
# THAMILI AI HUB - Environment Configuration
# ==============================================================================
# Rename or copy this file to `.env` in the project root to configure your AI providers.
# The backend automatically reads `.env` on startup.
# All API keys are securely kept on the backend and NEVER exposed to frontend scripts.
# ==============================================================================

# Server Port (Default: 8080)
PORT=8080

# ------------------------------------------------------------------------------
# 1. LLM & Conversational AI (AI Chat, Code Tools, Content Tools)
# ------------------------------------------------------------------------------
# Google Gemini API Key (Recommended for high-speed Tamil & English processing)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=

# OpenAI API Key (GPT-4o / GPT-4o-mini / DALL-E / TTS)
# Get a key at: https://platform.openai.com/
OPENAI_API_KEY=

# Groq API Key (Ultra-fast Llama-3 / Mixtral inference)
# Get a key at: https://console.groq.com/
GROQ_API_KEY=

# Anthropic Claude API Key (Optional)
# Get a key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# 2. Image Generation & Editing (Image Tools)
# ------------------------------------------------------------------------------
# Dedicated Image API Key (e.g., Stability AI / OpenAI DALL-E / Replicate / Pollinations)
IMAGE_API_KEY=
STABILITY_API_KEY=
REPLICATE_API_KEY=

# ------------------------------------------------------------------------------
# 3. Video Generation & Image-to-Video (Video Tools)
# ------------------------------------------------------------------------------
# Video API Key (e.g., Luma Dream Machine / Runway / Replicate SVD / Pika)
VIDEO_API_KEY=

# ------------------------------------------------------------------------------
# 4. Audio & Voice Synthesis (Audio Tools / TTS)
# ------------------------------------------------------------------------------
# ElevenLabs API Key (High-fidelity voice synthesis) or OpenAI TTS
ELEVENLABS_API_KEY=
AUDIO_API_KEY=
